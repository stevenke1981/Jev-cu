# Jev decision helper only. GPT runs in ChatGPT desktop, not through this key.
# Copy this template to .env.local, then fill in the real key there.
# Do not put real credentials in this tracked .env.example file.
# install-skill imports only OPENROUTER_API_KEY to ~/.agents/jev-cu/.env.
# Existing installed credentials are preserved; use --force --update-key to rotate.
# Default: typesafe/jev-1.13 at OpenRouter Decisions API.
OPENROUTER_API_KEY=
